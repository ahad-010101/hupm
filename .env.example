APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Storage timezone is UTC by design (D-07). Every business date — due day,
# grace expiry, day-5 delinquency, proration, "not future" validation —
# resolves through App\Support\BusinessCalendar in settings('company.timezone'),
# default America/New_York. Never change this to a local timezone: a job running
# at 01:00 UTC would evaluate the wrong Georgia calendar day.
APP_TIMEZONE=UTC

# MySQL 8.0+ required — the leases.active_unit_key generated column (D-03) and
# several JSON columns do not exist below it.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hupm_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# [D-17] Resend over its HTTPS API in production. **Never smtp there** —
# HostGator blocks the SMTP ports, which is the whole constraint behind TDD §2's
# "email over HTTPS API" rule. Production sets MAIL_MAILER=resend.
#
# Locally you have two choices, and only the driver changes:
#
#   log   — messages go to storage/logs/laravel.log. No dependency, but you are
#           reading raw MIME rather than looking at what the resident sees.
#   smtp  — caught by Mailpit on 127.0.0.1:1025, read at http://127.0.0.1:8025.
#           Nothing leaves the machine, so a notice to all 26 residents is safe
#           to send and safe to look at. Host and port below already point at it.
#
# Notifications are queued, so nothing arrives until the queue is drained:
#   php artisan queue:work --stop-when-empty
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@headsupenterprises.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# [D-17] Resend. Required in production; leave blank locally (log or Mailpit).
RESEND_API_KEY=
# Shared secret from the Resend dashboard, used to verify webhook signatures.
RESEND_WEBHOOK_SECRET=

# Authorize.Net (WP-13). eCheck.Net must be enabled by their support team —
# it is a request, not a dashboard toggle. `sandbox` until WP-35.
AUTHORIZE_NET_ENVIRONMENT=sandbox
AUTHORIZE_NET_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
AUTHORIZE_NET_SIGNATURE_KEY=
