# ---------------------------------------------------------------------------
# TDD 6.3 shared-hosting hardening.  [WP-34]
#
# `.env`, `storage/` and `vendor/` sit outside the document root by
# construction, so none of this is the primary defence -- it is the second one,
# for the day a deploy copies the tree to the wrong place or somebody unpacks a
# backup under public/. Apache serving a stray `.env` is not a hypothetical on
# shared hosting; it is the single most common way a Laravel key leaks.
#
# mod_authz_core (Apache 2.4) and mod_access_compat (2.2) are both handled, in
# that order, because cPanel hosts vary and a directive the running Apache does
# not understand is a 500 for the whole site.
# ---------------------------------------------------------------------------

# Dotfiles: .env, .env.backup, .git/config, .htpasswd, editor droppings.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
</IfModule>

# Documentation and anything else that ships in the tree but is not a page.
<FilesMatch "\.(md|markdown|yml|yaml|lock|json|ini|log|sh|sql|bak|dist|example)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# composer.json is the one JSON above that a curious visitor might guess; the
# rule covers it. index.php stays reachable -- it is not matched by any pattern
# here.

# No directory listings anywhere, not only where mod_negotiation is loaded.
Options -Indexes

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Re-allow PHP in THIS directory.  [WP-00H, 27 Aug 2026]
#
# The HostGator account carries a host-applied malware-remediation rule in
# /home5/jabrilgino/public_html/.htaccess (mode 444, and present in sixteen
# places across the account):
#
#     <FilesMatch '.(py|exe|php|PHP|...|php5|suspected)$'>
#     Order allow,deny
#     Deny from all
#     </FilesMatch>
#
# .htaccess inherits downward, so it reaches this document root and returns
# 403 for index.php before PHP is ever invoked. That is what made the whole
# site 403 while static files served normally, and why disabling the
# .htaccess IN this directory changed nothing — the rule is above it.
#
# Written in mod_access_compat syntax on purpose, matching the parent. Apache
# 2.4 evaluates those directives IN ADDITION TO the modern ones, so a
# `Require all granted` here does NOT cancel a `Deny from all` above; it was
# tried first and the site stayed at 403.
#
# Scope is this directory only. The parent rule is untouched and PHP stays
# denied everywhere else on the account.
# ---------------------------------------------------------------------------
<FilesMatch "\.(php|php5|phtml)$">
    Order allow,deny
    Allow from all
</FilesMatch>
